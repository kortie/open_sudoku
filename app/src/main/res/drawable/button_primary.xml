<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#1A3D2E"
                android:endColor="#0F2818" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_gold" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#2D6A56"
                android:endColor="#1A4D3E" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_gold" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#2D6A56"
                android:endColor="#1A4D3E" />
            <stroke
                android:width="1.5dp"
                android:color="@color/border_light" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
