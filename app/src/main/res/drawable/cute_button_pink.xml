<?xml version="1.0" encoding="utf-8"?>
<!-- Cute candy button: pastel face with a darker bottom edge; sinks when pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp"><shape android:shape="rectangle"><solid android:color="@color/candy_pink" /><corners android:radius="20dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp"><shape android:shape="rectangle"><solid android:color="@color/candy_pink_dark" /><corners android:radius="20dp" /></shape></item>
            <item android:bottom="4dp"><shape android:shape="rectangle"><solid android:color="@color/candy_pink" /><corners android:radius="20dp" /></shape></item>
        </layer-list>
    </item>
</selector>
