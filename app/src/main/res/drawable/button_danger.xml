<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#B71C1C"
                android:endColor="#8B0000" />
            <stroke
                android:width="2dp"
                android:color="#FF6B6B" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#E74C3C"
                android:endColor="#C0392B" />
            <stroke
                android:width="1.5dp"
                android:color="@color/border_light" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
