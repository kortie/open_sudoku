<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/accent_gold_dark"
                android:endColor="@color/accent_gold" />
            <stroke
                android:width="2dp"
                android:color="#FFD700" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/accent_gold"
                android:endColor="#C9A061" />
            <stroke
                android:width="1.5dp"
                android:color="#FFD700" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/bg_tertiary"
                android:endColor="@color/bg_secondary" />
            <stroke
                android:width="1.5dp"
                android:color="@color/border_light" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
