<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="@color/bg_primary"
    tools:context=".ui.home.DifficultySelectionFragment">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🐣"
        android:textSize="44sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Pick your level!"
        android:textAppearance="@style/TextAppearance.Headline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:text="How brave are you feeling today?"
        android:textAppearance="@style/TextAppearance.Body" />

    <TextView
        android:id="@+id/button_easy"
        style="@style/CuteButton"
        android:background="@drawable/cute_button_mint"
        android:text="🌱  Easy" />

    <TextView
        android:id="@+id/button_medium"
        style="@style/CuteButton"
        android:background="@drawable/cute_button_yellow"
        android:text="🌼  Medium" />

    <TextView
        android:id="@+id/button_hard"
        style="@style/CuteButton"
        android:background="@drawable/cute_button_peach"
        android:text="🔥  Hard" />

    <TextView
        android:id="@+id/button_hacker"
        style="@style/CuteButton"
        android:background="@drawable/cute_button_lavender"
        android:text="👾  Hacker" />

</LinearLayout>
