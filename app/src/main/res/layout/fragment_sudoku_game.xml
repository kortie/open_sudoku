<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Headline bar with difficulty and playing time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/background_light"
        android:elevation="4dp"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_difficulty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Difficulty: Beginner"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/text_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

    </LinearLayout>

    <!-- Sudoku grid -->
    <com.example.sudoku.sudoku.view.SudokuGridView
        android:id="@+id/sudoku_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center_horizontal" />

    <!-- Separator line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@android:color/darker_gray"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <!-- Number buttons in a row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/button_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="12dp"
            android:minHeight="56dp"
            android:background="@drawable/improved_button_background"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/button_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="12dp"
            android:minHeight="56dp"
            android:background="@drawable/improved_button_background"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/button_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="12dp"
            android:minHeight="56dp"
            android:background="@drawable/improved_button_background"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/button_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="12dp"
            android:minHeight="56dp"
            android:background="@drawable/improved_button_background"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/button_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="12dp"
            android:minHeight="56dp"
            android:background="@drawable/improved_button_background"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/button_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="6"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="12dp"
            android:minHeight="56dp"
            android:background="@drawable/improved_button_background"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/button_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="7"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="12dp"
            android:minHeight="56dp"
            android:background="@drawable/improved_button_background"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/button_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="12dp"
            android:minHeight="56dp"
            android:background="@drawable/improved_button_background"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/button_9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="9"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="12dp"
            android:minHeight="56dp"
            android:background="@drawable/improved_button_background"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/button_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="12dp"
            android:minHeight="56dp"
            android:background="@drawable/improved_button_background"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/button_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Note"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="12dp"
            android:minHeight="56dp"
            android:background="@drawable/improved_button_background"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/button_give_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Give Up"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="12dp"
            android:minHeight="56dp"
            android:background="@drawable/improved_button_background"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />
    </LinearLayout>

</LinearLayout>
