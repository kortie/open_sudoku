<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/bg_primary">

    <!-- Headline bar with difficulty and playing time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/cute_card"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_difficulty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Difficulty: Beginner"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/text_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/cute_chip"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="00:00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary_dark" />

    </LinearLayout>

    <!-- Sudoku grid -->
    <com.juanstudio.sudoku.sudoku.view.SudokuGridView
        android:id="@+id/sudoku_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"
        android:layout_gravity="center_horizontal" />

    <!-- Number buttons in a row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/button_1"
            style="@style/CuteNumberButton"
            android:text="1" />

        <TextView
            android:id="@+id/button_2"
            style="@style/CuteNumberButton"
            android:text="2" />

        <TextView
            android:id="@+id/button_3"
            style="@style/CuteNumberButton"
            android:text="3" />

        <TextView
            android:id="@+id/button_4"
            style="@style/CuteNumberButton"
            android:text="4" />

        <TextView
            android:id="@+id/button_5"
            style="@style/CuteNumberButton"
            android:text="5" />

        <TextView
            android:id="@+id/button_6"
            style="@style/CuteNumberButton"
            android:text="6" />

        <TextView
            android:id="@+id/button_7"
            style="@style/CuteNumberButton"
            android:text="7" />

        <TextView
            android:id="@+id/button_8"
            style="@style/CuteNumberButton"
            android:text="8" />

        <TextView
            android:id="@+id/button_9"
            style="@style/CuteNumberButton"
            android:text="9" />
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/button_clear"
            style="@style/CuteActionButton"
            android:text="🧽 Clear" />

        <TextView
            android:id="@+id/button_note"
            style="@style/CuteActionButton"
            android:background="@drawable/cute_button_toggle"
            android:text="✏️ Note" />

        <TextView
            android:id="@+id/button_give_up"
            style="@style/CuteActionButton"
            android:background="@drawable/cute_button_peach"
            android:text="🏳️ Give Up" />
    </LinearLayout>

</LinearLayout>
